<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Nueva Señal Disponible - Deep Signals</title>
  <link href="https://fonts.googleapis.com/css2?family=Red+Hat+Display:ital,wght@0,300..900;1,300..900&display=swap" rel="stylesheet">
 <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --black: #000000;
      --white: #FFFFFF;
      --cyan: #2CFFF4;
      --cyan-light: #00E5E5;
      --deepPrimary: #4DFFE7FF;
      --deepSecondary: #1E6896;
    }

    body {
      font-family: "Red Hat Display", sans-serif;
      background-color: var(--black);
      color: var(--white);
      margin: 0;
      padding: 0;
    }

    .email-container {
      max-width: 600px;
      margin: 0 auto;
      background-color: var(--black);
      padding: 40px 20px;
      display: flex;
      flex-direction: column;
      gap: 77px;
    }

    .top-content {
      display: flex;
      position: relative;
      align-items: center;
      justify-content: left;
      border-radius: 42px;
      border: 2px solid white;
      padding: 0 60px;
      overflow: hidden;
      min-height: 350px;
    }

    .header {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .title-nueva {
      font-size: 24px;
      font-weight: 500;
      color: var(--white);
      line-height: 1.1;
      margin-bottom: 5px;
      letter-spacing: -1px;
    }

    .title-disponible {
      font-size: 48px;
      font-weight: 700;
      line-height: 1.1;
      background: linear-gradient(135deg, var(--deepPrimary) 0%, var(--deepSecondary) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      letter-spacing: -1px;
    }

    .logo {
      width: 160px;
      height: auto;
    }

    /* Hero Section */
    .hero-section {
      position: absolute;
      right: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .background-image {
      position: absolute;
      left: -325px;
      top: -180px;
      width: 370px;
      height: 370px;
      z-index: 0;
    }


    .bell-image {
      z-index: 3;
      position: absolute;
      left: -325px;
      top: -135px;
      width: 160px;
      height: auto;
      display: block;
    }

    .phone-image {
      position: absolute;
      /* top: -200px; */
      top: -130px;
      right: 0px;
      width: 230px;
      height: auto;
      z-index: 2;
      opacity: 0.9;
    }


    /* Subtitle */
    .subtitle {
      text-align: center;
      font-size: 20px;
      font-weight: 400;
      color: var(--cyan);
      margin-bottom: 25px;
      line-height: 1.4;
    }

    .subtitle-highlight {
      font-weight: 600;
    }

    /* Description */
    .description {
      font-size: 16px;
      font-weight: 300;
      color: var(--white);
      line-height: 1.6;
      margin-bottom: 35px;
      max-width: 500px;
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    .description strong {
      font-weight: 600;
    }

    /* CTA Button */
    .cta-container {
      text-align: center;
    }

    .cta-button {
      display: inline-block;
      background-color: var(--cyan);
      color: var(--black);
      text-decoration: none;
      font-size: 16px;
      font-weight: 600;
      padding: 16px 70px;
      border-radius: 30px;
      transition: all 0.3s ease;
      box-shadow: 0 4px 15px rgba(0, 217, 217, 0.3);
    }

    .cta-button:hover {
      background-color: var(--cyan-light);
      box-shadow: 0 6px 20px rgba(0, 217, 217, 0.5);
      transform: translateY(-2px);
    }

    /* Footer */
    .footer {
      text-align: center;
    }

    .footer-text {
      font-size: 13px;
      color: var(--white);
      margin-bottom: 30px;
      line-height: 1.5;
    }

    .footer-text strong {
      color: var(--white);
      font-weight: 500;
    }

    .footer-logo {
      width: 100%;
      height: auto;
      margin-bottom: 25px;
      opacity: 0.7;
    }

    /* Social Icons */
    .social-icons {
      display: flex;
      justify-content: center;
      gap: 20px;
      margin-bottom: 25px;
    }

    .social-icon {
      display: inline-block;
      transition: opacity 0.3s ease;
    }

    .social-icon:hover {
      opacity: 0.7;
    }

    .social-icon img {
      width: 24px;
      height: 24px;
      filter: invert(1);
    }

    /* Copyright */
    .copyright {
      font-size: 12px;
      color: var(--white);
      margin-top: 20px;
    }

    /* Responsive */
    @media (max-width: 600px) {
      .email-container {
        padding: 30px 15px;
      }

      .title-nueva,
      .title-disponible {
        font-size: 36px;
      }

      .subtitle {
        font-size: 18px;
      }

      .description {
        font-size: 14px;
      }

      .bell-image {
        width: 160px;
      }

      .phone-image {
        width: 140px;
        right: -20px;
      }

      .cta-button {
        padding: 14px 50px;
        font-size: 15px;
      }
    }
  </style>
</head>
<body>
  <div class="email-container">

    <div class="top-content">
      <!-- Header -->
      <div class="header">
        <img src="<%= logoUrl %>" alt="Deep Signals" class="logo">
        <div class="title-section">
          <div class="title-nueva">NUEVA SEÑAL</div>
          <div class="title-disponible">DISPONIBLE</div>
        </div>
      </div>
  
      <!-- Hero Section -->
      <div class="hero-section">
        <img src="<%= bellImageUrl %>" alt="Nueva Señal" class="bell-image">
        <img src="<%= phoneImageUrl %>" alt="App" class="phone-image">
        <img src="<%= backgroundImageUrl %>" alt="App" class="background-image">
      </div>
  
      <!-- Title -->
    </div>


    <div>
      <!-- Subtitle -->
      <div class="subtitle">
        Revisa tu aplicación enviamos una <span class="subtitle-highlight">nueva señal</span>
      </div>
  
      <!-- Description -->
      <div class="description">
        <%= signal.description %> <strong><%= signal.pair %></strong>
      </div>
  
      <!-- CTA Button -->
      <div class="cta-container">
        <a href="<%= appUrl %>" class="cta-button">Abrir aplicación</a>
      </div>
    </div>

    <!-- Footer -->
    <div class="footer">
      <div class="footer-text">
        Estás recibiendo este correo porque eres miembro de <strong><%= companyName %></strong>
      </div>

      <img src="<%= footerImageUrl %>" alt="Deep Signals" class="footer-logo">

      <!-- Social Icons -->
      <div class="social-icons">
        <a href="<%= instagramUrl %>" class="social-icon" target="_blank">
          <img src="<%= instagramIconUrl %>" alt="Instagram">
        </a>
        <a href="<%= youtubeUrl %>" class="social-icon" target="_blank">
          <img src="<%= youtubeIconUrl %>" alt="YouTube">
        </a>
      </div>

      <!-- Copyright -->
      <div class="copyright">
        © <%= companyName %>, derechos reservados
      </div>
    </div>

  </div>
</body>
</html>
